# 复制为 .env 后填入真实值（.env 不会被提交）

# ---- 模型网关（OpenAI 兼容中转服务，用于 Qwen）----
DASHSCOPE_API_KEY=
OPENAI_BASE_URL=https://maas.qianwenai.com/compatible-mode/v1
LLM_MODEL_QWEN=qwen3.8-flash

# ---- DeepSeek（生成主模型 / 评测裁判）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_DEEPSEEK=deepseek-chat

# ---- Milvus ----
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=medical_docs
EMBEDDING_DIM=1024

# ---- Ollama（本地 embedding / 重排无关）----
OLLAMA_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3

# ---- PostgreSQL（预留，当前未接入业务逻辑）----
PG_DSN=postgresql://postgres:postgres@localhost:5432/medical

# ---- 检索参数 ----
RECALL_TOP_K=5
MAX_RETRIEVAL_RETRY=2
USE_RERANK=false
